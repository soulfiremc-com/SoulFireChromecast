{
  "name": "soulfire-chromecast",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "fix": "biome check --write --unsafe",
    "check": "biome check",
    "preview": "vite preview",
    "test": "bun test",
    "protocol:pack": "bun run --cwd packages/cast-protocol build && cd packages/cast-protocol && bun pm pack --destination ../../artifacts",
    "postinstall": "bun run --cwd packages/cast-protocol build"
  },
  "dependencies": {
    "@soulfiremc/cast-protocol": "workspace:*",
    "@tailwindcss/vite": "^4.1.5",
    "@tanstack/charts": "1.5.0",
    "@tanstack/react-hotkeys": "^0.22.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "effect": "4.1.2",
    "lucide-react": "^1.0.0",
    "non.geist": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "^1.4.4",
    "@types/chromecast-caf-receiver": "^7.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.1.5",
    "typescript": "^7.0.0",
    "vite": "^8.0.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@swc/core",
    "@tailwindcss/oxide",
    "esbuild"
  ],
  "workspaces": [
    "packages/*"
  ]
}
