{
  "name": "soulfire-chromecast",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && bun scripts/write-build-output.ts",
    "typecheck": "tsc --noEmit && tsc -p tests --noEmit && tsc -p scripts --noEmit",
    "fix": "oxlint --fix && oxfmt",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run lint && bun run format:check",
    "preview": "vite preview",
    "test": "bun test",
    "protocol:pack": "bun run --cwd packages/cast-protocol build && cd packages/cast-protocol && bun pm pack --destination ../../artifacts",
    "postinstall": "bun run --cwd packages/cast-protocol build",
    "prepare": "lefthook install && effect-tsgo patch --no-typescript --oxlint",
    "pre-commit": "lefthook run pre-commit"
  },
  "dependencies": {
    "@soulfiremc/cast-protocol": "workspace:*",
    "@tailwindcss/vite": "^4.1.5",
    "@tanstack/charts": "1.5.0",
    "@tanstack/react-hotkeys": "^0.27.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "effect": "4.1.5",
    "lucide-react": "^1.0.0",
    "non.geist": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "1.0.0-rc.3",
    "@cloudflare/config": "1.0.0-rc.3",
    "@effect/tsgo": "0.73.2",
    "@shadcn/lint": "0.2.5",
    "@tanstack/eslint-plugin-query": "5.108.2",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@types/bun": "^1.4.4",
    "@types/chromecast-caf-receiver": "^7.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "cf": "1.0.0-rc.2",
    "eslint": "10.15.0",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.1.5",
    "typescript": "^7.0.0",
    "vite": "^8.0.0"
  },
  "packageManager": "bun@1.4.5",
  "trustedDependencies": [
    "@swc/core",
    "@tailwindcss/oxide",
    "esbuild"
  ],
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "26"
  }
}
